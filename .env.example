# Copy to .env (`cp .env.example .env`). Never commit .env.
# Priority: pytest CLI options > real environment variables > .env > defaults in core/config.py

# Target environment: local (Docker, everything runs) | remote (public site, read-only)
ENV=local

# Optional: override the default URL of the selected environment
# BASE_URL=http://localhost

# Admin credentials (required). These are the public demo credentials documented by
# Restful Booker Platform; in CI they come from GitHub Actions secrets.
ADMIN_USER=admin
ADMIN_PASSWORD=password
